MAX_DOCUMENTS=100
INTERVAL_MINUTES=30
OCR_PROVIDER=tesseract
MCA_BASE_URL=https://www.mca.gov.in/
DATA_DIR=./data
LOCAL_PDF_DIR=./data/inbox
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2
DISCOVERY_MAX_PAGES=40
DISCOVERY_MAX_DEPTH=2
OCR_MAX_PDF_PAGES=100
OCR_MIN_TEXT_CHARS=80

